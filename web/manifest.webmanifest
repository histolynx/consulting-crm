{
  "name": "HIVE: Consulting Mind",
  "short_name": "HIVE",
  "description": "Knowledge-graph CRM for a consulting practice",
  "id": "/",
  "start_url": "/#dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0d0f12",
  "theme_color": "#0d0f12",
  "icons": [
    { "src": "/icons/hive.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Ask the Hive", "url": "/#ask", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Graph", "url": "/#graph", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log time", "url": "/#time", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
